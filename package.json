{
  "name": "dsh-ihome",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugin for home renovation and smart homes.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
