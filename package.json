{
  "name": "dsh-ihome",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugin for home renovation and smart homes.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./expert-team-preset": "./dist/expert-team-preset.js",
    "./needs-analyst-preset": "./dist/expert-team-preset.js"
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "dist/expert-team-preset.js",
    "cordis.patch.yml",
    "locale/*.json",
    "skills"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/three": "0.183.1",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "three": "0.183.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
